# Copy to .env (git-ignored) to override defaults. Placeholders only: never commit real credentials.
DB_PATH=data/pipeline.db
LOG_LEVEL=INFO

# Alert delivery. "file" writes .eml files to ALERT_OUTBOX_DIR (no server needed).
# "smtp" sends through SMTP_HOST:SMTP_PORT (e.g. a local Mailpit on 1025) and also keeps a file copy.
ALERT_SINK=file
ALERT_OUTBOX_DIR=data/outbox
ALERT_FROM=alerts@example.local
ALERT_TO=you@example.local

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
